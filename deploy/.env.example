# 复制为 .env 后按需填写（.env 不应入库，确认 .gitignore 已忽略）
#   cp .env.example .env
#
# dev 演示（docker compose up，默认 profile）无需任何配置。
# 以下仅在切换到达梦/生产（--profile dm）时需要。

# ---- 达梦 DM8（--profile dm 时必需）----
# 达梦官方镜像需授权，不随仓库分发，请填写自有镜像 tag
DM_IMAGE=dameng/dm8:your-tag
DM_SYSDBA_PWD=change-me
DM_HOST_PORT=5236

# ---- 数据源（application-dm.yml 使用自定义变量名，非 SPRING_DATASOURCE_*）----
DB_HOST=db-dm
DB_PORT=5236
DB_NAME=mm_security
DB_USERNAME=SYSDBA
DB_PASSWORD=change-me

# ---- 安全基线（dm/prod 必需；dev 可留空，由 dev profile 自带密钥兜底）----
# JWT >= 32 字节，签名 >= 16 字节；缺失即启动失败（fail-fast）
# 生产务必替换为随机高熵值，切勿使用占位值
JWT_SECRET=
SIGNATURE_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ---- 运行 profile（dev = H2 内存库演示；dm = 达梦生产）----
SPRING_PROFILES_ACTIVE=dm
