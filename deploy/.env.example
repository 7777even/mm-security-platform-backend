# =============================================================================
# mm-security-platform 环境变量模板
# 用法（在 backend-scaffold/deploy/ 目录）：cp .env.example .env  并填写
# docker compose 自动加载 .env（docker-compose.yml: env_file: .env, required: false）
#
# 注意：敏感项（JWT_SECRET / SIGNATURE_SECRET / DB_PASSWORD）缺失时，
#       prod / dm profile 会启动失败（fail-fast，符合安全基线）；
#       dev profile 自带 dev 密钥，无需填写即可起。
# =============================================================================

# ---- 运行 profile ----
# dev（H2 内存库，开箱即用） / prod（PostgreSQL） / dm（达梦 DM8，信创生产目标）
SPRING_PROFILES_ACTIVE=dev

# ---- CORS 白名单（生产务必显式注入，勿用 *）----
# 多域名逗号分隔：https://a.example.com,https://b.example.com
CORS_ALLOWED_ORIGINS=*

# ---- 密钥（prod/dm 必需，无默认值）----
# JWT_SECRET 建议 ≥ 256bit 随机串；SIGNATURE_SECRET 建议 ≥ 256bit
JWT_SECRET=
SIGNATURE_SECRET=

# ---- 数据源 ----
# dm profile：DB_HOST=db-dm  DB_PORT=5236  username=SYSDBA
# prod profile：DB_HOST=postgres  DB_PORT=5432  username=postgres
DB_HOST=db-dm
DB_PORT=5236
DB_NAME=mm_security
DB_USERNAME=SYSDBA
DB_PASSWORD=

# ---- Cookie 安全（生产 HTTPS 必须为 true）----
COOKIE_SECURE=false
